managed implementation in class zbp_i_qcm_case unique;
strict ( 2 );
with draft;

define behavior for ZI_QCM_CASE
alias QualityCase
persistent table zqcm_case
draft table zqcm_case_d
lock master total etag LastChangedAt
authorization master ( none )
etag master LocalLastChangedAt
{
  create;
  update;
  delete;

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare
  {
    validation validateDates;
    validation validateCategory;
  }

  field ( readonly, numbering : managed ) CaseId;
  field ( mandatory : create ) Title, CategoryId;
  field ( readonly ) CreatedBy,
                     CreatedAt,
                     LocalLastChangedBy,
                     LocalLastChangedAt,
                     LastChangedAt;

  association     _Notes {create; with draft;}
  association _Approvals {create; with draft;}
  association _History   {create; with draft;}

  validation validateDates on save
  {
    create;
    update;
    field OccurrenceDate, DueDate;
  }

  validation validateCategory on save
  {
    create;
    update;
    field CategoryId;
  }

  mapping for zqcm_case
  {
    CaseId                 = case_uuid;
    CaseNumber             = case_number;
    Title                  = title;
    Description            = description;
    CategoryId             = category_id;
    PriorityCode           = priority_code;
    StatusCode             = status_code;
    PlantId                = plant_id;
    ReporterId             = reporter_id;
    InvestigatorId         = investigator_id;
    OccurrenceDate         = occurrence_date;
    DueDate                = due_date;
    Resolution             = resolution;
    CreatedBy              = created_by;
    CreatedAt              = created_at;
    LocalLastChangedBy     = local_last_changed_by;
    LocalLastChangedAt     = local_last_changed_at;
    LastChangedAt          = last_changed_at;
  }


}

define behavior for ZI_QCM_NOTE
alias QualityNote
persistent table zqcm_note
draft table zqcm_note_d
lock dependent by _Case
authorization dependent by _Case
etag master LocalLastChangedAt
{
  update;
  delete;

  field ( readonly, numbering : managed ) NoteId;

  field ( readonly )
    CaseId,
    CreatedBy,
    CreatedAt,
    LocalLastChangedBy,
    LocalLastChangedAt,
    LastChangedAt;

  association _Case {with draft;}

  mapping for zqcm_note
  {
    NoteId                 = note_uuid;
    CaseId                 = case_uuid;
    TypeCode               = note_type_code;
    Text                   = note_text;
    InternalFlag           = internal_flag;
    CreatedBy              = created_by;
    CreatedAt              = created_at;
    LocalLastChangedBy     = local_last_changed_by;
    LocalLastChangedAt     = local_last_changed_at;
    LastChangedAt          = last_changed_at;
  }
}

define behavior for ZI_QCM_APPROVAL
alias QualityApproval
persistent table zqcm_approval
draft table zqcm_approval_d
lock dependent by _Case
authorization dependent by _Case
etag master LocalLastChangedAt
{
  update;
  delete;

  field ( readonly, numbering : managed ) ApprovalId;

  field ( readonly )
    CaseId,
    CreatedBy,
    CreatedAt,
    LocalLastChangedBy,
    LocalLastChangedAt,
    LastChangedAt;

  association _Case {with draft;}

  mapping for zqcm_approval
  {
    ApprovalId             = approval_uuid;
    CaseId                 = case_uuid;
    ApprovalStep           = approval_step;
    DecisionCode           = decision_code;
    ApproverId             = approver_id;
    RequestedBy            = requested_by;
    RequestedAt            = requested_at;
    DecidedAt              = decided_at;
    DecisionReason         = decision_reason;
    CreatedBy              = created_by;
    CreatedAt              = created_at;
    LocalLastChangedBy     = local_last_changed_by;
    LocalLastChangedAt     = local_last_changed_at;
    LastChangedAt          = last_changed_at;
  }
}

define behavior for ZI_QCM_HISTORY
alias QualityHistory
persistent table zqcm_history
draft table zqcm_history_d
lock dependent by _Case
authorization dependent by _Case
{

  field ( readonly, numbering : managed ) HistoryId;

  field ( readonly )
    CaseId,
    CreatedBy,
    CreatedAt;

  association _Case {with draft;}

  mapping for zqcm_history
  {
    HistoryId              = history_uuid;
    CaseId                 = case_uuid;
    EventCode              = event_code;
    PreviousStatusCode     = previous_status_code;
    NewStatusCode          = new_status_code;
    ActorId                = actor_id;
    EventText              = event_text;
    CreatedBy              = created_by;
    CreatedAt              = created_at;
  }
}