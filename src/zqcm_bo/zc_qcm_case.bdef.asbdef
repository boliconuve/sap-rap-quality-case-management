projection;
strict ( 2 );
use draft;

define behavior for ZC_QCM_CASE alias QualityCase
use etag
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _Notes { create; with draft;}
  use association _Approvals { create; with draft;}
  use association _History {with draft;}
}

define behavior for ZC_QCM_APPROVAL alias QualityApproval
use etag
{
  use update;
  use delete;

  use association _Case {with draft;}
}

define behavior for ZC_QCM_HISTORY alias QualityHistory
{

  use association _Case {with draft;}
}

define behavior for ZC_QCM_NOTE alias QualityNote
use etag
{
  use update;
  use delete;

  use association _Case{with draft;}
}